FROM node:22.20-bookworm-slim
ARG NEXT_PUBLIC_VERSION
ARG NEXT_PUBLIC_BRAND_NAME
ARG NEXT_PUBLIC_BRAND_SHORT_NAME
ARG NEXT_PUBLIC_BRAND_LOGO_URL
ARG NEXT_PUBLIC_BRAND_LOGO_TEXT_URL
ARG NEXT_PUBLIC_BRAND_FAVICON_URL
ARG NEXT_PUBLIC_BRAND_PRIMARY_COLOR
ARG NEXT_PUBLIC_BRAND_SECONDARY_COLOR
ARG NEXT_PUBLIC_BRAND_ACCENT_COLOR
ARG NEXT_PUBLIC_BRAND_TEXT_DARK
ARG NEXT_PUBLIC_BRAND_TEXT_LIGHT
ARG NEXT_PUBLIC_BRAND_GRADIENT_START
ARG NEXT_PUBLIC_BRAND_GRADIENT_END
ARG NEXT_PUBLIC_BRAND_WEBSITE_URL
ARG NEXT_PUBLIC_BRAND_SUPPORT_URL
ARG NEXT_PUBLIC_BRAND_TERMS_URL
ARG NEXT_PUBLIC_BRAND_PRIVACY_URL
ARG NEXT_PUBLIC_BRAND_AUTH_HEADLINE
ARG NEXT_PUBLIC_BRAND_AUTH_STAT
ARG NEXT_PUBLIC_BRAND_APP_TITLE

ENV NEXT_PUBLIC_VERSION=$NEXT_PUBLIC_VERSION \
    NEXT_PUBLIC_BRAND_NAME=$NEXT_PUBLIC_BRAND_NAME \
    NEXT_PUBLIC_BRAND_SHORT_NAME=$NEXT_PUBLIC_BRAND_SHORT_NAME \
    NEXT_PUBLIC_BRAND_LOGO_URL=$NEXT_PUBLIC_BRAND_LOGO_URL \
    NEXT_PUBLIC_BRAND_LOGO_TEXT_URL=$NEXT_PUBLIC_BRAND_LOGO_TEXT_URL \
    NEXT_PUBLIC_BRAND_FAVICON_URL=$NEXT_PUBLIC_BRAND_FAVICON_URL \
    NEXT_PUBLIC_BRAND_PRIMARY_COLOR=$NEXT_PUBLIC_BRAND_PRIMARY_COLOR \
    NEXT_PUBLIC_BRAND_SECONDARY_COLOR=$NEXT_PUBLIC_BRAND_SECONDARY_COLOR \
    NEXT_PUBLIC_BRAND_ACCENT_COLOR=$NEXT_PUBLIC_BRAND_ACCENT_COLOR \
    NEXT_PUBLIC_BRAND_TEXT_DARK=$NEXT_PUBLIC_BRAND_TEXT_DARK \
    NEXT_PUBLIC_BRAND_TEXT_LIGHT=$NEXT_PUBLIC_BRAND_TEXT_LIGHT \
    NEXT_PUBLIC_BRAND_GRADIENT_START=$NEXT_PUBLIC_BRAND_GRADIENT_START \
    NEXT_PUBLIC_BRAND_GRADIENT_END=$NEXT_PUBLIC_BRAND_GRADIENT_END \
    NEXT_PUBLIC_BRAND_WEBSITE_URL=$NEXT_PUBLIC_BRAND_WEBSITE_URL \
    NEXT_PUBLIC_BRAND_SUPPORT_URL=$NEXT_PUBLIC_BRAND_SUPPORT_URL \
    NEXT_PUBLIC_BRAND_TERMS_URL=$NEXT_PUBLIC_BRAND_TERMS_URL \
    NEXT_PUBLIC_BRAND_PRIVACY_URL=$NEXT_PUBLIC_BRAND_PRIVACY_URL \
    NEXT_PUBLIC_BRAND_AUTH_HEADLINE=$NEXT_PUBLIC_BRAND_AUTH_HEADLINE \
    NEXT_PUBLIC_BRAND_AUTH_STAT=$NEXT_PUBLIC_BRAND_AUTH_STAT \
    NEXT_PUBLIC_BRAND_APP_TITLE=$NEXT_PUBLIC_BRAND_APP_TITLE
RUN apt-get update && apt-get install -y --no-install-recommends \
    g++ \
    make \
    python3-pip \
    bash \
    nginx \
&& rm -rf /var/lib/apt/lists/*

RUN addgroup --system www \
 && adduser --system --ingroup www --home /www --shell /usr/sbin/nologin www \
 && mkdir -p /www \
 && chown -R www:www /www /var/lib/nginx


RUN npm --no-update-notifier --no-fund --global install pnpm@10.6.1 pm2

WORKDIR /app

COPY . /app
COPY var/docker/nginx.conf /etc/nginx/nginx.conf

RUN pnpm install
RUN NODE_OPTIONS="--max-old-space-size=4096" pnpm run build

CMD ["sh", "-c", "nginx && pnpm run pm2"]
