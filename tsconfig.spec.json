{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2020",
    "jsx": "react-jsx",
    "types": ["jest", "node"],
    "incremental": false,
    "resolveJsonModule": true
  },
  "include": ["**/*.spec.ts", "**/*.spec.tsx", "jest.unit.config.ts"],
  "exclude": ["node_modules", "dist", "tmp", "**/.next"]
}
